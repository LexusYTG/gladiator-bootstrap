#!/bin/bash
# gl-run — lanza apps con el entorno correcto para Gladiator.
# - Exporta DISPLAY, sockets, SDL, XDG
# - Si el binario linkea GLX (libGL.so.1 / SDL2 / GLFW), aplica LD_PRELOAD=gl4es.
# - Si no, arranca limpio: Scutum entra por resolucion normal de libEGL/libGLESv2.
app="$1"; shift
[ -z "$app" ] && { echo "uso: gl-run <app> [args...]" >&2; exit 1; }

if [ -x "$app" ]; then bin="$app"
elif command -v "$app" >/dev/null 2>&1; then bin="$(command -v "$app")"
else echo "gl-run: no encontrado: $app" >&2; exit 127; fi

# Env base
export DISPLAY="${DISPLAY:-:0}"
export XDG_RUNTIME_DIR=/tmp
export SDL_VIDEO_X11_FORCE_EGL=1
export SDL_VIDEO_EGL_DRIVER=/usr/lib/aarch64-linux-gnu/libEGL.so
export ALSOFT_DRIVERS=null
[ -z "$SPATHA_SOCK" ] && export SPATHA_SOCK=/host-tmp/spatha.sock
[ -z "$SCUTUM_SOCK" ] && export SCUTUM_SOCK=/host-tmp/scutum.sock
[ -z "$PULSE_SERVER" ] && export PULSE_SERVER=/host-tmp/pulse.sock
export LD_LIBRARY_PATH="/usr/lib/aarch64-linux-gnu${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}"

# Heuristica GLX
# Lee perfiles de /etc/gladiator/app-profiles.conf y aplica env vars por binario.
apply_profile() {
    local bin_name="$1"
    local conf="/etc/gladiator/app-profiles.conf"
    [ -f "$conf" ] || return 0
    while IFS='|' read -r name rest; do
        [ -z "$name" ] && continue
        case "$name" in \#*) continue ;; esac
        [ "$name" = "$bin_name" ] || continue
        for kv in $rest; do
            [ -z "$kv" ] && continue
            export "$kv"
        done
    done < "$conf"
}

needs_glx() {
    local b="$1"
    [ "$GL_RUN_FORCE_GLX" = "1" ] && return 0
    ! file "$b" 2>/dev/null | grep -q "ELF" && return 1
    ldd "$b" 2>/dev/null | grep -q 'libGL\.so\.1' && return 0
    ldd "$b" 2>/dev/null | grep -qE 'libSDL2|libglfw' && return 0
    return 1
}
if needs_glx "$bin"; then
    export LD_PRELOAD=/usr/lib/aarch64-linux-gnu/libGL.so.1${LD_PRELOAD:+:$LD_PRELOAD}
fi

apply_profile "$(basename "$bin")"
exec "$bin" "$@"
