# Config minima de PulseAudio para Gladiator.
# Los paths se sustituyen en runtime via sed por el arranque de sesion.
load-module @MODS@/module-native-protocol-unix.so socket=@HOST_TMP@/pulse.sock auth-anonymous=1
load-module @MODS@/module-null-sink.so sink_name=gladiator_out
load-module @MODS@/module-simple-protocol-unix.so record=true source=gladiator_out.monitor socket=@HOST_TMP@/orator-pa.sock format=s16le channels=2 rate=44100
set-default-sink gladiator_out
